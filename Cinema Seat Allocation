class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {

        HashMap<Integer, Integer> map = new HashMap<>();

        // Store reserved seats for each row using a bitmask
        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int s = seat[1];

            if (s >= 2 && s <= 9) {
                int bit = 1 << (s - 2);
                map.put(row, map.getOrDefault(row, 0) | bit);
            }
        }

        // Masks for the three possible groups
        int left = 0b00001111;    // seats 2,3,4,5
        int middle = 0b00111100;  // seats 4,5,6,7
        int right = 0b11110000;   // seats 6,7,8,9

        long answer = 2L * n;

        for (int mask : map.values()) {

            // Initially this row was counted as 2 groups.
            // Find how many groups this row can actually accommodate.

            if ((mask & left) == 0 && (mask & right) == 0) {
                // Both left and right blocks are available
                // So it can still accommodate 2 groups.
                continue;
            }

            if ((mask & left) == 0 ||
                (mask & middle) == 0 ||
                (mask & right) == 0) {

                // At least one block is available
                answer--;
            } else {
                // No block is available
                answer -= 2;
            }
        }

        return (int) answer;
    }
}
