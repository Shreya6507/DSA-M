class Solution {
    public int[] validSequence(String word1, String word2) {
        int n = word1.length();
        int m = word2.length();

        int[] ans = new int[m];

        // last[j] = rightmost index in word1 that can be used
        // to match word2[j], while still matching the suffix
        // word2[j...m-1].
        int[] last = new int[m];

        for (int j = 0; j < m; j++) {
            last[j] = -1;
        }

        int i = n - 1;
        int j = m - 1;

        // Build the rightmost valid matching positions.
        while (i >= 0 && j >= 0) {
            if (word1.charAt(i) == word2.charAt(j)) {
                last[j] = i;
                j--;
            }
            i--;
        }

        // We are allowed to use at most one mismatch.
        boolean canMismatch = true;

        i = 0;
        j = 0;

        while (i < n && j < m) {

            // Normal matching character.
            if (word1.charAt(i) == word2.charAt(j)) {
                ans[j] = i;
                j++;
            }

            // Use the one allowed mismatch.
            else if (canMismatch &&
                    (j == m - 1 || i < last[j + 1])) {

                ans[j] = i;
                j++;

                // The mismatch has now been used.
                canMismatch = false;
            }

            i++;
        }

        // Could not construct the complete sequence.
        if (j != m) {
            return new int[0];
        }

        return ans;
    }
}

