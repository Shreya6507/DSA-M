class Solution {
    static final int MOD = 1000000007;

    public int numberOfSets(int n, int k) {
        long[][] dp = new long[n][k + 1];

        // dp[i][j] = number of ways to draw j segments
        // using points 0 to i

        // 0 segments -> 1 way
        for (int i = 0; i < n; i++) {
            dp[i][0] = 1;
        }

        for (int j = 1; j <= k; j++) {
            long sum = 0;

            for (int i = 1; i < n; i++) {

                // Add dp[i-1][j-1] to the running sum.
                // This represents choosing the starting point
                // of the last segment.
                sum = (sum + dp[i - 1][j - 1]) % MOD;

                // Either:
                // 1. Don't end a segment at i
                // 2. End a segment at i
                dp[i][j] = (dp[i - 1][j] + sum) % MOD;
            }
        }

        return (int) dp[n - 1][k];
    }
}
